{
  "name": "piglet-app",
  "version": "2.0.0",
  "description": "Piglet - A dual-LLM macOS agent app based on UI-TARS-desktop architecture",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "postinstall": "electron-rebuild -f -w robotjs",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@langchain/core": "1.1.8",
    "@langchain/langgraph": "^1.0.7",
    "@langchain/openai": "^1.2.0",
    "@langchain/classic": "^1.0.7",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "jimp": "^0.22.10",
    "langchain": "^1.2.3",
    "lucide-react": "^0.562.0",
    "openai": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "robotjs": "^0.6.0",
    "screenshot-desktop": "^1.15.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^9.0.0",
    "zod": "^3.25.32",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.piglet.app",
    "productName": "Piglet",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAccessibilityUsageDescription": "Piglet needs accessibility permissions to control the mouse and keyboard for automation tasks.",
        "NSAppleEventsUsageDescription": "Piglet needs to control other applications to perform tasks."
      }
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "package.json"
    ]
  }
}
